---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import DemoModal from '../components/DemoModal.astro';

export interface Props {
  title: string;
  description?: string;
}

const { title, description = 'CI Data Hub — The definitive data platform for captive insurance.' } = Astro.props;

type NavData = { links: { label: string; href: string }[]; demoButtonLabel: string };
type FooterData = { tagline: string; columns: { heading: string; links: { label: string; href: string }[] }[]; legalLinks: { label: string; href: string }[]; copyright: string };
type DemoModalData = { heading: string; subtext: string; roles: string[]; successHeading: string; successBody: string };

let nav: NavData = { links: [], demoButtonLabel: 'Request Demo' };
let footer: FooterData = { tagline: '', columns: [], legalLinks: [], copyright: '' };
let demoModal: DemoModalData = { heading: 'Request a Demo', subtext: '', roles: [], successHeading: '', successBody: '' };

const projectId = import.meta.env.SANITY_PROJECT_ID;
if (projectId) {
  try {
    const { sanityClient } = await import('../lib/sanity');
    const settings = await sanityClient.fetch(`*[_type == "siteSettings"][0]{
      nav { links[] { label, href }, demoButtonLabel },
      demoModal { heading, subtext, roles, successHeading, successBody },
      footer { tagline, columns[] { heading, links[] { label, href } }, legalLinks[] { label, href }, copyright }
    }`);
    if (settings?.nav) nav = settings.nav;
    if (settings?.footer) footer = settings.footer;
    if (settings?.demoModal) demoModal = settings.demoModal;
  } catch (e) {
    // fall back to defaults
  }
}
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
</head>
<body>

  <Nav
    links={nav.links}
    demoButtonLabel={nav.demoButtonLabel}
  />

  <slot />

  <Footer
    tagline={footer.tagline}
    columns={footer.columns}
    legalLinks={footer.legalLinks}
    copyright={footer.copyright}
  />

  <DemoModal
    heading={demoModal.heading}
    subtext={demoModal.subtext}
    roles={demoModal.roles}
    successHeading={demoModal.successHeading}
    successBody={demoModal.successBody}
  />

</body>
</html>
