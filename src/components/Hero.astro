---
export interface HeroStat {
  number: string;
  label: string;
}

export interface HeroChartBar {
  label: string;
  value: number;
}

export interface HeroChartMetric {
  value: string;
  label: string;
  highlight?: boolean;
}

export interface Props {
  badge: string;
  headline: string;
  gradientWord: string;
  subtext: string;
  primaryCtaLabel: string;
  stats: HeroStat[];
  chartBars?: HeroChartBar[];
  chartCaption?: string;
  chartMetrics?: HeroChartMetric[];
}

const { badge, headline, gradientWord, subtext, primaryCtaLabel, stats, chartBars, chartCaption, chartMetrics } = Astro.props;

const bars = (chartBars ?? []).filter((b) => b && typeof b.value === 'number');
const maxValue = bars.reduce((m, b) => (b.value > m ? b.value : m), 0);
const metrics = (chartMetrics ?? []).filter((m) => m && (m.value || m.label));
---

<section class="hero">
  <div class="hero__bg"></div>
  <div class="container">
    <div class="hero__content">
      <div class="hero__badge">{badge}</div>
      <h1 class="hero__headline">
        {headline}<br />
        <span class="gradient-text">{gradientWord}</span>
      </h1>
      <p class="hero__sub">{subtext}</p>
      <div class="hero__actions">
        <button class="btn btn--primary btn--lg" id="heroDemoBtn">{primaryCtaLabel}</button>
      </div>
      <div class="hero__stats">
        {(stats || []).map((stat, i) => (
          <>
            <div class="hero__stat">
              <span class="hero__stat-number">{stat.number}</span>
              <span class="hero__stat-label">{stat.label}</span>
            </div>
            {i < stats.length - 1 && <div class="hero__stat-divider"></div>}
          </>
        ))}
      </div>
    </div>
    <div class="hero__visual">
      <div class="dashboard-mock">
        <div class="dashboard-mock__header">
          <div class="dashboard-mock__dot red"></div>
          <div class="dashboard-mock__dot amber"></div>
          <div class="dashboard-mock__dot green"></div>
          <span>Ci DataHub — Key Statistics</span>
        </div>
        <div class="dashboard-mock__body">
          <div class="mock-chart">
            <div class="mock-chart__bars">
              {bars.map((bar, i) => {
                const h = maxValue > 0 ? Math.round((bar.value / maxValue) * 80) : 0;
                const isAccent = i % 2 === 1;
                return (
                  <div class="mock-bar-col">
                    <span class="mock-bar__value">{bar.value}</span>
                    <div class={`mock-bar${isAccent ? ' mock-bar--accent' : ''}`} style={`--h: ${h}%`}>
                      <span>{bar.label}</span>
                    </div>
                  </div>
                );
              })}
            </div>
            <p class="mock-chart__label">{chartCaption}</p>
          </div>
          <div class="mock-metrics">
            {metrics.map((metric) => (
              <div class={`mock-metric${metric.highlight ? ' mock-metric--highlight' : ''}`}>
                <span class="mock-metric__val">{metric.value}</span>
                <span class="mock-metric__lbl">{metric.label}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.getElementById('heroDemoBtn')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('openDemoModal'));
  });
</script>
