---
export interface PricingTier {
  name: string;
  price: string;
  note?: string;
  features?: string[];
  featured?: boolean;
}

export interface Props {
  badge: string;
  heading: string;
  subtext: string;
  tiers: PricingTier[];
}

const { badge, heading, subtext, tiers } = Astro.props;
---

<section class="section section--dark" id="pricing">
  <div class="container">
    <div class="section__header section__header--light">
      <div class="section__badge section__badge--light">{badge}</div>
      <h2>{heading}</h2>
      {subtext && <p>{subtext}</p>}
    </div>
    <div class="pricing-grid">
      {(tiers || []).map((tier) => (
        <div class={`pricing-card${tier.featured ? ' pricing-card--featured' : ''}`}>
          {tier.featured && <div class="pricing-card__label">Best Value</div>}
          <h3 class="pricing-card__name">{tier.name}</h3>
          <div class="pricing-card__price">{tier.price}</div>
          {tier.note && <p class="pricing-card__note">{tier.note}</p>}
          {tier.features?.length ? (
            <ul class="pricing-card__features">
              {tier.features.map((feature) => <li>{feature}</li>)}
            </ul>
          ) : null}
        </div>
      ))}
    </div>
  </div>
</section>
