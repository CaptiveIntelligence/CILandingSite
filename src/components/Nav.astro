---
export interface Props {
  links: { label: string; href: string }[];
  demoButtonLabel: string;
}

const { links, demoButtonLabel } = Astro.props;
---

<nav class="nav" id="nav">
  <div class="nav__inner">
    <a href="#" class="nav__logo">
      <img src="/images/Captive Intelligence Logo Long.png" alt="Captive Intelligence" />
    </a>
    <ul class="nav__links">
      <li class="nav__dropdown">
        <button class="nav__dropdown-toggle" aria-haspopup="true" aria-expanded="false">
          Products
          <svg class="nav__dropdown-chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <ul class="nav__dropdown-menu">
          <li><a href="#">Data Hub</a></li>
          <li><a href="https://captiveintelligence.io">News</a></li>
          <li><a href="https://captiveintelligence.io/upcoming-captive-events/">Events</a></li>
          <li><a href="https://captiveintelligence.io/category/podcasts/">The Podcast</a></li>
        </ul>
      </li>
      {links.map((link) => (
        <li><a href={link.href}>{link.label}</a></li>
      ))}
    </ul>
    <div class="nav__cta">
      <button class="btn btn--primary btn--sm" id="navDemoBtn">{demoButtonLabel}</button>
    </div>
    <button class="nav__burger" id="navBurger" aria-label="Toggle menu">
      <span></span><span></span><span></span>
    </button>
  </div>
  <div class="nav__mobile" id="navMobile">
    <ul>
      <li class="nav-mobile-products">
        <button class="nav-mobile-products__toggle" id="navMobileProductsToggle" aria-expanded="false">
          Products
          <svg class="nav__dropdown-chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <ul class="nav-mobile-products__menu" id="navMobileProductsMenu">
          <li><a href="#" class="nav-mobile-link">Data Hub</a></li>
          <li><a class="nav-mobile-link"href="https://captiveintelligence.io">News</a></li>
          <li><a class="nav-mobile-link"href="https://captiveintelligence.io/upcoming-captive-events/">Events</a></li>
          <li><a class="nav-mobile-link"href="https://captiveintelligence.io/category/podcasts/">The Podcast</a></li>
        </ul>
      </li>
      {links.map((link) => (
        <li><a href={link.href} class="nav-mobile-link">{link.label}</a></li>
      ))}
    </ul>
    <button class="btn btn--primary" id="navMobileDemoBtn">{demoButtonLabel}</button>
  </div>
</nav>

<script>
  // Scroll effect
  const nav = document.getElementById('nav');
  if (nav) {
    window.addEventListener('scroll', () => {
      nav.classList.toggle('scrolled', window.scrollY > 20);
    }, { passive: true });
  }

  // Mobile menu toggle
  const burger = document.getElementById('navBurger');
  const mobileMenu = document.getElementById('navMobile');
  burger?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('open');
  });

  // Close mobile menu on link click
  document.querySelectorAll('.nav-mobile-link').forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.remove('open');
    });
  });

  // Mobile products dropdown toggle
  const mobileProductsToggle = document.getElementById('navMobileProductsToggle');
  const mobileProductsMenu = document.getElementById('navMobileProductsMenu');
  mobileProductsToggle?.addEventListener('click', () => {
    const isOpen = mobileProductsMenu?.classList.toggle('open');
    mobileProductsToggle.setAttribute('aria-expanded', String(!!isOpen));
    mobileProductsToggle.classList.toggle('open', !!isOpen);
  });

  // Demo button — dispatch custom event
  document.getElementById('navDemoBtn')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('openDemoModal'));
  });

  document.getElementById('navMobileDemoBtn')?.addEventListener('click', () => {
    mobileMenu?.classList.remove('open');
    window.dispatchEvent(new CustomEvent('openDemoModal'));
  });

  // Smooth scroll for anchor links
  document.querySelectorAll('a[href^="#"]').forEach(anchor => {
    anchor.addEventListener('click', function (this: HTMLAnchorElement, e: Event) {
      const href = this.getAttribute('href');
      if (href === '#') return;
      const target = document.querySelector(href!);
      if (target) {
        e.preventDefault();
        const navEl = document.getElementById('nav');
        const navHeight = navEl ? navEl.offsetHeight : 72;
        const top = (target as HTMLElement).getBoundingClientRect().top + window.scrollY - navHeight - 16;
        window.scrollTo({ top, behavior: 'smooth' });
      }
    });
  });
</script>
